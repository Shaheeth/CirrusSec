OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
API_KEY=                      # if set, API requires header X-API-Key
TRUSTED_CIDRS=10.0.0.0/8,203.0.113.0/24
UNUSED_KEY_DAYS=90
